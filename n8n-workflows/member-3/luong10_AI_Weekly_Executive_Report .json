              "id": "prompt_id",
              "name": "ai_prompt",
              "value": "={{ \"Bạn là Giám đốc dự án. Dưới đây là danh sách các công việc team đã hoàn thành trong tuần qua:\\n\" + JSON.stringify($json.data) + \"\\n\\nHãy viết một báo cáo tổng kết ngắn gọn.\\nBẮT BUỘC trả về kết quả CHỈ bằng một chuỗi JSON có định dạng sau (không giải thích thêm):\\n{\\n  \\\"ai_summary\\\": \\\"Viết 2-3 câu tóm tắt thành tích của team và những điểm sáng trong tuần\\\",\\n  \\\"completed_tasks_count\\\": \" + $json.data.length + \"\\n}\" }}",
