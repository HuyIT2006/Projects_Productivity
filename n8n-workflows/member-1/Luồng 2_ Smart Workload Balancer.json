    {
      "parameters": {
        "jsCode": "const a = $('Compute Distribution').first().json.assignments;\n    const q = (s) => \"'\" + String(s ?? '').replace(/'/g, \"''\") + \"'\";\n    const sql = a.length\n      ? 'INSERT INTO activity_history (task_id,member_id,action_type,new_value,metadata) VALUES ' +\n        a.map((x) => '(' + q(x.task_id) + '::uuid,' + q(x.member_id) + \"::uuid,'TASK_ASSIGNED',\" +\n          q(String(x.member_name).slice(0, 100)) + ',' + q(JSON.stringify({ source: 'flow2_workload_balancer' })) + '::jsonb)').join(',')\n      : 'SELECT 1';\n    return [{ json: { sql } }];"
      },
