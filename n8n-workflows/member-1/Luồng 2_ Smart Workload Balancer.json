    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT m.id, m.full_name, m.max_workload, m.skills, COALESCE(m.productivity_score,100)::float AS productivity_score, COUNT(t.id) FILTER (WHERE t.status IN ('TODO','IN_PROGRESS','IN_REVIEW'))::int AS current_load FROM members m LEFT JOIN tasks t ON t.assignee_id = m.id GROUP BY m.id ORDER BY m.full_name",
        "options": {}
      },
      "name": "Get Member Workload",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "alwaysOutputData": true,
      "id": "843db828-8914-49e1-9021-f4820b78017f",
      "position": [
        1312,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "GtFHLYZn1QvEQSpk",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const tasks = $('Collect Tasks').first().json.tasks;\n    const members = $input.all().map((i) => i.json).filter((m) => m.id)\n      .map((m) => Object.assign({}, m, { load: Number(m.current_load), max: Number(m.max_workload) }));\n    const assignments = [], unassigned = [];\n    for (const t of tasks) {\n      const cands = members.filter((m) => m.load < m.max);\n      if (!cands.length) { unassigned.push({ id: t.id, title: t.title }); continue; }\n      cands.sort((a, b) => (a.load / a.max) - (b.load / b.max) || b.productivity_score - a.productivity_score);\n      const m = cands[0];\n      m.load++;\n      assignments.push({ task_id: t.id, title: t.title, member_id: m.id, member_name: m.full_name });\n    }\n    const sql = assignments.length\n      ? 'UPDATE tasks t SET assignee_id = v.mid::uuid, updated_at = CURRENT_TIMESTAMP FROM (VALUES ' +\n        assignments.map((a) => \"('\" + a.task_id + \"','\" + a.member_id + \"')\").join(',') +\n        ') AS v(tid,mid) WHERE t.id = v.tid::uuid RETURNING t.id, t.title, t.assignee_id'\n      : 'SELECT NULL::uuid AS id WHERE false';\n    const workload = members.map((m) => ({ name: m.full_name, load: m.load, max: m.max }));\n    return [{ json: { assignments, unassigned, workload, sql } }];"
      },
