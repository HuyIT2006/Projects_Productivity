    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\n    const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n    const mail = /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/;\n    const pid = uuid.test(b.project_id || '') ? b.project_id : null;\n    const filter = pid ? \"AND project_id = '\" + pid + \"'::uuid \" : '';\n    const sql_tasks = 'SELECT id,title,story_points,priority,project_id FROM tasks WHERE assignee_id IS NULL ' + filter +\n      \"AND status <> 'DONE' ORDER BY CASE priority WHEN 'URGENT' THEN 1 WHEN 'HIGH' THEN 2 WHEN 'MEDIUM' THEN 3 ELSE 4 END, created_at\";\n    return [{ json: { sql_tasks, notify_email: mail.test(b.notify_email || '') ? b.notify_email : 'htchannelas@gmail.com' } }];"
      },
