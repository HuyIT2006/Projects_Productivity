    {
      "parameters": {
        "jsCode": "const d = $('Compute Distribution').first().json;\n    const email = $('Prepare Input').first().json.notify_email;\n    const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));\n    const rows = d.assignments.map((a) => '<tr><td>' + esc(a.title) + '</td><td>' + esc(a.member_name) + '</td></tr>').join('');\n    const load = d.workload.map((w) => '<li>' + esc(w.name) + ': ' + w.load + '/' + w.max + '</li>').join('');\n    const html = '<h2>⚖️ Cân bằng tải hoàn tất</h2><p>Đã gán <b>' + d.assignments.length + '</b> task, ' +\n      '<b>' + d.unassigned.length + '</b> task chưa gán được.</p>' +\n      '<table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse\"><tr><th>Task</th><th>Người nhận</th></tr>' + rows + '</table>' +\n      '<h3>Tải sau khi gán</h3><ul>' + load + '</ul>';\n    return [{ json: {\n      notify_email: email,\n      has_overflow: d.unassigned.length > 0,\n      subject: '✅ [Luồng 2] Đã gán ' + d.assignments.length + ' task',\n      html,\n      response: { success: true, assigned_count: d.assignments.length, unassigned_count: d.unassigned.length,\n        assignments: d.assignments, unassigned: d.unassigned, workload: d.workload },\n    } }];"
      },
