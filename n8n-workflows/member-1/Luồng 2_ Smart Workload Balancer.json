      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT m.id AS member_id, m.full_name, COUNT(t.id) AS current_workload, m.max_workload\nFROM members m\nLEFT JOIN tasks t ON t.assignee_id = m.id AND t.status IN ('TODO', 'IN_PROGRESS')\nGROUP BY m.id, m.full_name, m.max_workload\nHAVING COUNT(t.id) < m.max_workload\nORDER BY current_workload ASC\nLIMIT 1;",
